{
  "name": "lhs-verification-contracts",
  "version": "1.0.0",
  "description": "LHS Verification Smart Contracts",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.28.4",
    "@noble/curves": "^1.6.0",
    "solc": "0.8.20"
  },
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:mklhs": "npx hardhat test test/mklhs.test.js",
    "test:mklhs-adversarial": "npx hardhat test test/mklhs-adversarial.test.js",
    "gas:mklhs": "npx hardhat run scripts/mklhs_gas_audit.js",
    "adversarial:mklhs": "npx hardhat run scripts/mklhs_adversarial_audit.js",
    "emit:tfhe-mk": "cargo run --release --bin output_binding_tfhe -- emit-onchain-mk onchain_proofs_tfhe_mk.json 10 50 100 200",
    "test:tfhe-mk": "cargo test --release --bin output_binding_tfhe",
    "onchain:tfhe-mk": "npx hardhat run scripts/mklhs_tfhe_onchain.js",
    "payload:demo-mk": "node scripts/mklhs_make_demo_payload.mjs onchain_proofs_demo_mk.json 10 50 100 200",
    "onchain:demo-mk": "npx hardhat run scripts/mklhs_tfhe_onchain_demo.js",
    "onchain:demo-mk:ganache": "node scripts/mklhs_tfhe_onchain.mjs onchain_proofs_demo_mk.json mklhs_demo_gas_results_ganache.csv",
    "verify:soundness": "node scripts/verify_linear_soundness.mjs",
    "deps:ganache": "npm install --no-save ganache",
    "security:mklhs": "npx hardhat run scripts/mklhs_security_evaluation.js",
    "test:lwe-interop": "cargo run --release --bin output_binding_tfhe -- emit-lwe-interop scripts/lwe_interop_vectors.json && node --test scripts/lwe-interop.test.mjs",
    "shard:experiment": "npx hardhat run scripts/mklhs_shard_experiment.js",
    "plot:timings": "python3 scripts/plot_linear_timings.py"
  }
}
