{
  "name": "tfhe-pod-autoresearch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.10 <23"
  },
  "scripts": {
    "compile:contracts": "node scripts/compile-contracts.mjs",
    "eval:applications": "bash ../run-nonlinear.sh",
    "fhe:export": "node scripts/export-traces-for-fhe.mjs",
    "fhe:execute": "cargo run --release --bin fhe-executor --",
    "eval:costs": "bash ../run-nonlinear.sh",
    "eval:security": "bash ../run-nonlinear.sh",
    "eval:legacy-costs": "node scripts/run-verification-cost-evaluation.mjs",
    "eval:legacy-security": "node scripts/run-adversarial-security-evaluation.mjs",
    "example:linear-score": "node scripts/run-linear-score-example.mjs",
    "plot:latency": "python3 scripts/plot_nonlinear_latency.py",
    "verify:encrypted": "node scripts/verify-encrypted-execution.mjs",
    "audit:calldata": "node scripts/audit-calldata-leak.mjs",
    "network:preflight": "node scripts/network-preflight.mjs",
    "network:fund-signers": "node scripts/fund-signers.mjs",
    "demo:evm": "node scripts/run-evm-demo.mjs",
    "demo:hardhat": "hardhat run --no-compile scripts/run-hardhat-dispute-demo.mjs",
    "demo:anatel": "node ../Anatel/anatel-rqual/run-anatel-rqual-demo.mjs",
    "demo:anatel-simplified": "node ../Anatel/anatel-rqual-simplificado/run-anatel-rqual-simplified-demo.mjs",
    "demo:arithmetic": "node ../examples/exemplo-aritmetico/run-arithmetic-demo.mjs",
    "pipeline": "node scripts/run-full-pipeline.mjs",
    "test:fhe-correctness": "cargo test -p tfhe-pod-demo --test fhe_correctness -- --nocapture",
    "test:fhe-relation": "cargo test --release -p tfhe-pod-demo --test checked_relation -- --nocapture",
    "test:dataflow-fhe": "node scripts/explicit-dataflow-integration.mjs",
    "audit:leaf-disclosure": "node scripts/leaf-disclosure-counterexample.mjs",
    "test:fhe-equivalence": "cargo test --release -p tfhe-pod-demo --test fhe_equivalence -- --nocapture",
    "test:lowering": "node --test scripts/micro-isa.test.mjs scripts/application-lowering.test.mjs scripts/individual-privacy-lowering.test.mjs scripts/compliance-circuit.test.mjs scripts/explicit-dataflow.test.mjs",
    "test:leaf-decision": "node --test --test-timeout=3600000 scripts/leaf-decision-stability.test.mjs",
    "fixtures:stav360": "node scripts/generate-stav360-fixtures.mjs",
    "fixtures:qoe-mos": "node scripts/generate-qoe-mos-fixtures.mjs",
    "fixtures:qoe-tree": "node scripts/generate-qoe-tree-fixtures.mjs",
    "fixtures:regulatory": "node scripts/generate-regulatory-fixtures.mjs",
    "fixtures:webrtc": "node scripts/generate-webrtc-fixtures.mjs",
    "test:evm": "node --test --test-concurrency=1 --test-timeout=${VCFHE_TEST_TIMEOUT_MS:-2700000} contracts/test/registry.test.mjs contracts/test/sampling-availability.test.mjs contracts/test/authenticated-provenance.test.mjs contracts/test/leaf-onchain-enforcement.test.mjs contracts/test/kms-verdict-opening.test.mjs contracts/test/permissionless-assignment.test.mjs",
    "test:assignment": "node --test --test-timeout=${VCFHE_TEST_TIMEOUT_MS:-2700000} contracts/test/permissionless-assignment.test.mjs",
    "test:canonical-bounty": "node --test --test-concurrency=1 --test-timeout=${VCFHE_TEST_TIMEOUT_MS:-2700000} contracts/test/canonical-bounty.test.mjs",
    "test:soundness-boundaries": "node --test contracts/test/soundness-boundaries.test.mjs",
    "test:privacy": "node --test --test-concurrency=1 --test-timeout=${VCFHE_TEST_TIMEOUT_MS:-2700000} contracts/test/decryption-authorization.test.mjs contracts/test/private-dispute.test.mjs contracts/test/soundness-boundaries.test.mjs",
    "test:provenance": "node --test contracts/test/authenticated-provenance.test.mjs contracts/test/leaf-onchain-enforcement.test.mjs",
    "test:hardening": "node --test contracts/test/sampling-availability.test.mjs contracts/test/authenticated-provenance.test.mjs contracts/test/leaf-onchain-enforcement.test.mjs",
    "test:timing": "node --test --test-concurrency=1 --test-timeout=${VCFHE_TEST_TIMEOUT_MS:-2700000} contracts/test/timing-parameters.test.mjs",
    "gas:hardening": "node scripts/measure-hardening-gas.mjs",
    "gas:disclosure": "node scripts/measure-disclosure-request-gas.mjs",
    "demo:full": "powershell -ExecutionPolicy Bypass -File scripts/run_full_demo.ps1",
    "reader:dev": "node scripts/reader-server.mjs",
    "eval:threshold-scaling": "python3 ../threshold-kms/campaign/run.py --explain-threshold-scaling",
    "eval:legacy-threshold-scaling": "node scripts/run-threshold-opening-scaling.mjs",
    "eval:legacy-applications": "node scripts/run-application-layer-evaluation.mjs",
    "test:canonical-policy": "node --test scripts/canonical-domain.test.mjs scripts/output-release-policy.test.mjs scripts/simulated-output-kms.test.mjs scripts/canonical-certificates.test.mjs"
  },
  "dependencies": {
    "@fhevm/solidity": "^0.11.1",
    "ethers": "^6.15.0",
    "ganache": "^7.9.2",
    "marked": "^18.0.2",
    "mermaid": "^11.14.0",
    "solc": "^0.8.24"
  },
  "devDependencies": {
    "hardhat": "^3.4.1"
  }
}
