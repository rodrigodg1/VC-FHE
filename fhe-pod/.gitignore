target/
node_modules/
.local/
contracts/out/
contracts/cache/
contracts/hardhat-artifacts/
contracts/hardhat-cache/

artifacts/runs/*
!artifacts/runs/.gitkeep

# Canonical evidence: preserve all raw files locally, but version summaries,
# CSV/JSON results, seals and the compact raw-file inventory. Exact historical
# replay requires the retained fixtures/bin, not freshly generated substitute keys.
/artifacts/canonical/run-*/fixtures/
/artifacts/canonical/run-*/bin/

iterations/*
!iterations/.gitkeep

*.log
*.out

# TFHE ciphertexts and evaluation keys produced by scripts/../crates fhe-executor.
# A full run writes ~0.3 GB of serialized FheUint64 ciphertexts plus ~0.12 GB of
# keys. The traces and the handle manifest are small and stay tracked; the blobs
# are regenerated by `npm run fhe:execute`.
artifacts/fhe/**/ciphertexts/
artifacts/fhe/**/keys/
