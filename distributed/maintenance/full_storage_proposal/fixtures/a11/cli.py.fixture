#!/usr/bin/env python3
"""Distributed campaign. setup enables APIs. Cloud commands are explicit."""
import argparse
from decimal import Decimal
import json
from pathlib import Path
import subprocess
import sys
import gcp
import metrics
import preserve
import topology

HERE = Path(__file__).resolve().parent

def write(path, value):
    Path(path).write_text(json.dumps(value, indent=2)+"\n")

def budget(config):
    estimate = config["cost_estimate"]
    if any(estimate.get(k) is None for k in ("hourly_total", "planned_hours", "transfer_and_storage")):
        return {"status": "unpriced", "maximum_usd": config["budget"]["maximum"],
                "message": "No price or completion time has been measured or quoted. Do not infer that the full run fits USD 50."}
    values = [Decimal(str(estimate[k])) for k in ("hourly_total", "planned_hours", "transfer_and_storage")]
    if any(not v.is_finite() or v < 0 for v in values) or values[0] == 0 or values[1] == 0:
        raise ValueError("invalid cost estimate")
    estimated = values[0]*values[1]+values[2]
    available = Decimal(str(config["budget"]["maximum"]))-Decimal(str(config["budget"]["reserve"]))
    return {"status": "within-planning-envelope" if estimated <= available else "over-budget",
            "estimated_usd": str(estimated), "available_before_reserve_usd": str(available),
            "hard_billing_cap": False, "prices_and_runtime_verified": False}

def prepare(config, output):
    output = Path(output).resolve()
    if output.exists(): raise ValueError("use a new preparation directory")
    state = topology.plan(config)
    output.mkdir(parents=True)
    write(output/"config.json", config)
    write(output/"plan.json", state)
    write(output/"budget.json", budget(config))
    gcp.write(config, output/"terraform")
    import deployment
    for host,value in deployment.manifests(config,output.name).items():write(output/(host+'-compose.json'),value)
    lines = ["# Planned roles and hosts", "", "Offline bundle. Use readiness before the explicit launch command.", "",
             "| Role | Host | Region | Private address |", "|---|---|---|---|"]
    for n in state["nodes"]: lines.append(f"| {n['id']} | {n['host']} | {n['region']} | {n['private_ip']} |")
    (output/"ROLES.md").write_text("\n".join(lines)+"\n")
    write(output/"commands.json", {
        "read_only_cloud_checks": [["gcloud", "compute", "zones", "describe", r["zone"], "--project", config["project_id"], "--format=json"] for r in config["regions"]],
        "terraform_validation": [["terraform", "init", "-backend=false"], ["terraform", "validate"]],
        "cloud_actions_executed": [], "campaign_available": True,
        "note": "Preparation performs no cloud actions. launch requires images, a cost quote and a new run directory."})
    return {"directory": str(output), "hosts": len(state["hosts"]), "roles": len(state["nodes"]),
            "status": state["status"], "budget": budget(config)}

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["plan", "prepare", "preserve", "verify-snapshot", "summarize", "test", "readiness", "docker-check",
        "image-prepare","image-build","image-push","launch","publish","setup","cloud-build","cloud-run","audit-public","quote","status","smoke-config"])
    parser.add_argument("--config", type=Path, default=HERE/"config.example.json")
    parser.add_argument("--output", type=Path)
    parser.add_argument("--snapshot", type=Path)
    parser.add_argument("--events", type=Path, nargs="+")
    parser.add_argument("--build",type=Path)
    parser.add_argument("--quote",type=Path)
    parser.add_argument("--run",type=Path)
    parser.add_argument('--login',action='store_true',help='open Google login if no active account exists')
    parser.add_argument('--enable-apis',action='store_true',help='enable missing APIs during project setup')
    parser.add_argument('--smoke',action='store_true',help='separate nonpublishing real-threshold readiness workflows, never the evaluation grid')
    parser.add_argument('--hours',type=int,default=14,help='estimated infrastructure hours, never a promise of completion')
    parser.add_argument('--transfer-gib',type=int,default=48,help='planning allowance for inter-region traffic')
    parser.add_argument('--retention-hours',type=int,default=24,help='priced retention after compute stops')
    args = parser.parse_args()
    if args.command == "test":
        code = subprocess.call([sys.executable, "-m", "unittest", "discover", "-s", str(HERE/"tests"), "-v"])
        if code: return code
        return subprocess.call(["node", "--test", *map(str,sorted((HERE/'tests').glob('*.test.mjs')))])
    if args.command == "preserve":
        if not args.output: parser.error("preserve requires --output")
        result = preserve.preserve(args.output)
        print(json.dumps({"directory": str(args.output), "files": len(result["files"]),
                          "raw_run_copied": False, "private_state_copied": False}, indent=2))
        return 0
    if args.command == "verify-snapshot":
        if not args.snapshot: parser.error("verify-snapshot requires --snapshot")
        print(json.dumps(preserve.verify(args.snapshot), indent=2))
        return 0
    if args.command=='audit-public':
        import privacy
        print(json.dumps(privacy.audit(),indent=2));return 0
    if args.command=='status':
        if not args.run:parser.error('status requires --run')
        from status import snapshot
        print(json.dumps(snapshot(args.run),indent=2));return 0
    config = topology.validate(json.loads(args.config.read_text()))
    if args.command=='smoke-config':
        if not args.output or not args.output.name.endswith('.local.json'):
            parser.error('smoke-config requires a new private --output ending in .local.json')
        from privacy import require_private
        require_private(args.output)
        config['campaign']=config['campaign'][:15]+'-smoke'
        config['execution_mode']='smoke'
        topology.validate(config)
        with args.output.open('x') as stream:json.dump(config,stream,indent=2);stream.write('\n')
        print(json.dumps({'privateConfiguration':str(args.output),'cloudActions':[],
                          'fullWorkflows':3,'evaluationPublishable':False},indent=2));return 0
    if args.smoke:
        if args.command not in ('plan','prepare','quote','readiness','cloud-run','launch'):
            parser.error('--smoke is only for planning or explicitly launching the nonpublishing readiness workflows')
        config['execution_mode']='smoke'
    if args.command=='quote':
        if not args.output or not args.output.name.endswith('.local.json'):parser.error('quote requires a private --output ending in .local.json')
        from privacy import require_private
        require_private(args.output)
        from price_quote import make
        quote=make(config,args.hours,args.transfer_gib,args.retention_hours)
        write(args.output,quote)
        print(json.dumps(quote['admission'],indent=2))
        return 0 if quote['admission']['status']=='admit' else 2
    elif args.command=='setup':
        if not str(args.config.name).endswith('.local.json'):
            parser.error('setup requires --config ending in .local.json to keep account details private')
        from privacy import require_private
        require_private(args.config)
        output=args.output or HERE/'generated/project-setup.local.json'
        require_private(output)
        from cloud_setup import inspect
        report=inspect(config,enable=args.enable_apis,login=args.login)
        config['operator_principal']=report['operatorPrincipal']
        write(args.config,config)
        output.parent.mkdir(parents=True,exist_ok=True);write(output,report)
        print(json.dumps({'projectVerified':True,'billingEnabled':True,'quotaVerified':True,
            'privateReport':str(output),'evaluationVmsCreated':False},indent=2))
    elif args.command in ['cloud-build','cloud-run']:
        if not args.quote or not args.build:parser.error('cloud commands require --quote and --build')
        if args.command=='cloud-run' and not args.run:parser.error('cloud-run requires a new --run directory')
        if not args.config.name.endswith('.local.json'):parser.error('cloud execution requires a private .local.json configuration')
        from privacy import require_private
        for path in [args.config,args.build]:require_private(path)
        from cloud_tools import ensure
        ensure()
        from controller_inputs import prepare as prepare_inputs
        prepare_inputs()
        import cloud_setup,cloud_build,gce_image
        setup=cloud_setup.inspect(config,enable=True,login=args.login)
        config['operator_principal']=setup['operatorPrincipal']
        builder=gce_image if config.get('image_build_backend','gce')=='gce' else cloud_build
        publication=builder.build(config,json.loads(args.quote.read_text()),args.build)
        config['images']={'campaign':publication['digest'],'besu':publication['besuDigest']}
        config['maximum_vm_runtime_seconds']=int(float(json.loads(args.quote.read_text())['planned_hours'])*3600)
        write(args.config,config)
        if args.command=='cloud-run':
            from launch import launch
            result=launch(config,json.loads(args.quote.read_text()),args.build,args.run)
        else:result={'imagesReady':True,'evaluationVmsCreated':False,'privateReceipt':str(args.build/'published-image.json')}
        print(json.dumps(result,indent=2))
    elif args.command=='docker-check':
        if not args.output:parser.error('docker-check requires a new --output directory')
        from docker_check import check
        result=check(config,args.output)
        print(json.dumps(result,indent=2))
        return 2 if result['nativeWorkflows']['status']=='blocked' else 0
    elif args.command.startswith('image-'):
        import image
        if args.command=='image-prepare':
            if not args.output:parser.error('image-prepare requires a new --output directory')
            result=image.prepare(HERE.parent/'threshold-kms/.cache',args.output)
        else:
            if not args.build:parser.error('image-build/image-push require --build')
            if args.command=='image-build':result=image.build(args.build)
            else:
                if not args.quote:parser.error('image-push requires --quote including registry/transfer charges')
                result=image.push(config,json.loads(args.quote.read_text()),args.build)
        print(json.dumps(result,indent=2))
    elif args.command=='launch':
        if not all([args.quote,args.build,args.run]):parser.error('launch requires --quote, --build and a new --run')
        from cloud_tools import ensure
        ensure()
        from launch import launch
        print(json.dumps(launch(config,json.loads(args.quote.read_text()),args.build,args.run),indent=2))
    elif args.command=='publish':
        if not args.run:parser.error('publish requires a completed sealed --run')
        from publication import publish
        print(json.dumps(publish(args.run),indent=2))
    elif args.command == "plan": print(json.dumps(topology.plan(config), indent=2))
    elif args.command == "prepare":
        if not args.output: parser.error("prepare requires --output")
        print(json.dumps(prepare(config, args.output), indent=2))
    elif args.command == "summarize":
        if not args.output or not args.events: parser.error("summarize requires --output and --events")
        print(json.dumps(metrics.summarize(args.events, topology.plan(config), args.output), indent=2))
    elif args.command == "readiness":
        from launch import check_launch
        failures=[]
        if not args.quote or not args.build:failures.append('provide --quote and --build for complete preflight')
        else:
            try:check_launch(config,json.loads(args.quote.read_text()),args.build)
            except (OSError,ValueError,KeyError) as e:failures.append(str(e))
        print(json.dumps({'ready_to_launch':not failures,'cloud_actions_executed':[],
            'runtime_validation':'pending actual execution','failures':failures,'budget':budget(config)},indent=2))
        return 2 if failures else 0
    return 0

if __name__ == "__main__":
    try: raise SystemExit(main())
    except (OSError, ValueError, KeyError) as error: raise SystemExit("Distributed preparation: "+str(error))
