+++ b/core-client/src/decrypt.rs
@@ -209,6 +209,27 @@ pub(crate) async fn do_public_decrypt<R: Rng + CryptoRng>(
             )
             .await?;
 
+            // VC-FHE patch: machine-readable per-core result lines so a
+            // relayer can collect each core's external EIP-712 signature and
+            // submit it to an on-chain verifier.
+            for (idx, resp) in resp_response_vec.iter().enumerate() {
+                if let Some(payload) = resp.payload.as_ref() {
+                    let plaintexts = payload
+                        .plaintexts
+                        .iter()
+                        .map(|pt| format!("\"{}\"", hex::encode(&pt.bytes)))
+                        .collect::<Vec<_>>()
+                        .join(",");
+                    println!(
+                        "KMS_CC_EXT_SIG {{\"request_id\":\"{}\",\"response_index\":{},\"external_signature\":\"0x{}\",\"verification_key\":\"0x{}\",\"plaintexts\":[{}]}}",
+                        req_id.as_str(),
+                        idx,
+                        hex::encode(&resp.external_signature),
+                        hex::encode(&payload.verification_key),
+                        plaintexts
+                    );
+                }
+            }
             let res = format!("{resp_response_vec:x?}");
             Ok((req_id, res))
         });
