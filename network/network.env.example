# Generic EVM deployment. Never commit real private keys or mnemonics.
VCFHE_RPC_URL=https://rpc.sepolia.org
VCFHE_EXPECTED_CHAIN_ID=11155111

# Choose exactly one local-signing method. The complete default external sweep
# needs 19 distinct funded accounts; --all-scaling-external needs 35.
VCFHE_PRIVATE_KEYS=0x<64-hex-private-key-1>,0x<64-hex-private-key-2>
# VCFHE_MNEMONIC=<development-or-testnet-mnemonic>
# VCFHE_ACCOUNT_COUNT=20

# Optional preflight floor. Increase it to match stake plus gas requirements.
VCFHE_MIN_BALANCE_WEI=0

# Protocol windows are deployment parameters. The 20-second defaults are for
# instant-mining development chains. Set values that cover block time and all
# sequential role transactions on a public network (illustrative only):
DEMO_COMMIT_WINDOW_SECONDS=180
DEMO_OPEN_WINDOW_SECONDS=180
DEMO_CHALLENGE_WINDOW_SECONDS=180

# Iteration controls. Full evaluation defaults are 10 / 10 / full. The --fast
# profile defaults to 2 / 2 / smoke; explicit values here override the profile.
# VCFHE_LINEAR_REPEATS=10
# VCFHE_KMS_REPEATS=10
# FHE_CORRECTNESS_PROFILE=full

# Optional live Zama KMS measurement. These variables do not by themselves
# wire KMS ciphertext handles through the dispute contract.
KMS_REPO=/absolute/path/to/pinned/zama-kms
KMS_KEY_ID=<existing-threshold-key-id>
